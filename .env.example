# ---------------------------------------------------------------------------
# Template for the environment file.
#
# This file IS committed and holds no secrets. Copy it to .env if you want
# one — .env is git-ignored, so anything you put there stays on your machine.
#
#   Windows (PowerShell):  Copy-Item .env.example .env
#   macOS / Linux:         cp .env.example .env
#
# You do NOT need this file to run the app. Every setting below has a working
# default; a .env only matters if you want to change one.
#
# ---------------------------------------------------------------------------
# Why there is no API key here
# ---------------------------------------------------------------------------
#
# Most AI app templates start with an API key. This one does not, and that
# absence is the point: THIS APP NEVER CALLS A HOSTED MODEL.
#
# The model runs on your machine through Ollama, and the customer data sits
# in a SQLite file next to this one. Nothing leaves the machine, so there is
# nothing to authenticate with and nothing to bill. "Where does the key
# live?" is the question that tells you where your data goes — and here the
# answer is nowhere.
# ---------------------------------------------------------------------------

# Port the app (chat, log and rep screen) listens on.
PORT=3200

# Port the data MCP server listens on when run over HTTP with
# `npm run data-server:http` — for MCP Inspector or another MCP client.
# The app itself does not use this: it talks to the data server over stdio.
DATA_SERVER_PORT=3201

# Port for the read-only data browser (`npm run data:browse`): every table
# and row, for people. Separate from the app; the model never sees it.
DATA_BROWSER_PORT=3202

# Where Ollama is listening. This is Ollama's own default.
#
# Keep it on localhost. Pointing it at another machine sends every question,
# and the customer data the tools return, across the network — which is the
# thing this project exists to avoid.
OLLAMA_URL=http://127.0.0.1:11434

# The model to use when the UI has not picked one.
#
# Chosen by the eval (docs/model-eval.md), not by assumption. On this
# project's machine (4 GB GPU), against the same prompts, 3 runs each:
#
#                           qwen3.5:4b    llama3.2:3b
#   in-scope questions      88% passed    57% passed
#   off-topic stopped       100%          94%
#   seconds per question    ~33           ~12
#
# qwen3.5:4b is the default because it gets questions RIGHT — it chains
# tools (find a customer, then their orders), asks when a name is
# ambiguous, and never wrote a tool call as text. llama3.2:3b is three
# times faster but often invents tool arguments, and its chat template
# hides the tool definitions after the first call. Pick it in the UI to
# feel the trade-off. qwen3.5:4b "thinks" by default; the app turns that off.
#
# Must be a LOCAL model. Names ending in ":cloud" run on ollama.com, and the
# app refuses them.
MODEL=qwen3.5:4b

# Context window, in tokens, sent as options.num_ctx on every request.
#
# Set explicitly because Ollama's default is small (4096 on most laptops),
# and when a conversation outgrows it Ollama SILENTLY DROPS whole older
# messages — keeping the system prompt and the newest message, reporting no
# error. A dropped message can be a tool result, and the model then answers
# from nothing. (Measured: see docs/verified-facts.md.) The app warns when
# this happens. 8192 fits six tool definitions, the system prompt and a few
# turns of history; a larger value costs memory — and on a 4 GB GPU, speed.
NUM_CTX=8192
